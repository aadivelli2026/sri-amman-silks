{
  // Cloudflare Worker பெயர் – உங்கள் workers.dev பெயருடன் ஒத்திருக்க வேண்டும்
  "name": "sri-amman-silks",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      // Cloudflare → Storage & Databases → KV → Create → அதன் ID-ஐ இங்கே ஒட்டவும்
      "id": "இங்கே_KV_ID_ஒட்டவும்"
    }
  ]
}
